{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "server/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-activity",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/:match*",
      "destination": "/api/admin/[...path]?path=:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/[...path]?path=:match*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
