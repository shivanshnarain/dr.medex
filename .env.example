# ==============================================================================
# DR.MEDEX GLOBAL — SERVER ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env in the project root:
#   cp .env.example .env
# Never commit the actual .env file or production secret credentials to Git.
# ==============================================================================

# Server Network Configuration
PORT=4000

# DR.MEDEX Admin Authentication
ADMIN_EMAIL=Roshan.official0009@gmail.com
ADMIN_PASSWORD_SALT=your_generated_salt_hex
ADMIN_PASSWORD_HASH=your_generated_sha256_hash_hex
SESSION_SECRET=your_random_secure_session_secret_key

# Cloudinary Media Assets (Product Catalog Images & PDF Brochures)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# MongoDB Database Configuration (Catalogue, Orders, Inquiries)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=medicuroglobal

# Google Gemini AI Integration (Product Classifier & Review Assistant)
# Existing key used by both Admin Product AI Assistant and Review Drafting
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_PROJECT_NAME=your_google_cloud_project_name
GEMINI_PROJECT_NUMBER=your_google_cloud_project_number

# Firebase Cloud Firestore (Product Reviews & Customer Feedback)
FIREBASE_PROJECT_ID=drmedex
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Supabase Auth & PostgreSQL Integration (Server-Side Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# PayPal Payment Gateway Integration (Server-Side REST API)
# Mode: "sandbox" for testing, "live" for production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
